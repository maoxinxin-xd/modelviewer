{
  "name": "mivo-model-viewer",
  "version": "0.6.0",
  "description": "Browser 3D viewer SDK and pure Node model processing CLI: inspect, render, convert and optimize.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "three.js",
    "3d",
    "model-viewer",
    "gltf",
    "glb",
    "fbx",
    "obj",
    "step",
    "vrml",
    "viewer",
    "sdk"
  ],
  "files": [
    "dist",
    "node",
    "README.md",
    "docs/cli-design.md",
    "Dockerfile.node",
    "THIRD_PARTY_FBX2GLTF_LICENSE.txt"
  ],
  "sideEffects": false,
  "main": "./dist/mivo-model-viewer.js",
  "module": "./dist/mivo-model-viewer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mivo-model-viewer.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/mivo-model-viewer-core.js"
    },
    "./package.json": "./package.json",
    "./node": {
      "types": "./node/index.d.ts",
      "import": "./node/index.mjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:demo": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=/modelviewer/",
    "build": "npm run typecheck && npm run build:lib",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "test:node": "node --test test/node-*.test.mjs",
    "cli": "node node/cli.mjs"
  },
  "peerDependencies": {
    "occt-import-js": ">=0.0.23",
    "three": ">=0.170.0"
  },
  "peerDependenciesMeta": {
    "occt-import-js": {
      "optional": true
    }
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@napi-rs/canvas": "1.0.10",
    "commander": "15.0.0",
    "draco3dgltf": "1.5.7",
    "fbx2gltf": "0.9.7-p1",
    "fflate": "^0.8.3",
    "linkedom": "0.18.13",
    "meshoptimizer": "1.2.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "mivo-model-viewer": "./node/cli.mjs"
  },
  "optionalDependencies": {
    "occt-import-js": "0.0.23",
    "webgpu": "0.6.2"
  }
}
