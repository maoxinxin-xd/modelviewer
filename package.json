{
  "name": "mivo-model-viewer",
  "version": "0.2.0",
  "description": "Multi-format browser 3D model viewer SDK — default UI or headless engine, easy to embed in any frontend page.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "three.js",
    "3d",
    "model-viewer",
    "gltf",
    "glb",
    "fbx",
    "obj",
    "viewer",
    "sdk"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "main": "./dist/mivo-model-viewer.js",
  "module": "./dist/mivo-model-viewer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mivo-model-viewer.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/mivo-model-viewer-core.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:demo": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=/modelviewer/",
    "build": "npm run typecheck && npm run build:lib",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "three": ">=0.150.0"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "three": "^0.170.0"
  },
  "engines": {
    "node": ">=18"
  }
}
